# Local development: copy to .env.local and fill in. Never commit .env.local.
# CI enforces: no SUPABASE_SERVICE_ROLE_KEY outside src/lib/server/ (pnpm check:security).

# --- Supabase ---------------------------------------------------------
# Local values come from `pnpm db:status` once `pnpm setup` has run.
# NOTE: local API/DB run on the 544xx range (54321/54322 are taken by the
# founder's other local Supabase project) — see supabase/config.toml.
# Staging/prod: Supabase dashboard, region EU (eu-central-1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-pnpm-db-status>
# SERVER-ONLY. Webhook/queue workers only. Never NEXT_PUBLIC_*, never in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-pnpm-db-status>

# --- Sentry (optional locally; leave blank to disable) -----------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- LLM providers (keys only — provider/model selection lives in ai_config) ---
# Dev keys with a hard monthly spend cap ($50). Anthropic primary, OpenAI secondary (ADR-0001).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email (Resend — used from Phase 3, provisioning notifies earlier) --
RESEND_API_KEY=

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
